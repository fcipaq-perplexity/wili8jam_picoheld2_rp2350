; I2S transmitter, 16-bit stereo, MSB first, standard I2S (data delayed 1 BCLK after LRCLK).
;
; Pico Held 2 pin order: side-set bit 0 = LRCLK (GPIO 37), bit 1 = BCLK (GPIO 38).
; (The Fruit Jam original had BCLK on the lower pin; the bits are swapped here.)
; OUT pin = DATA (GPIO 39). One 32-bit FIFO word = L (upper 16) | R (lower 16).
; PIO clock = 2x BCLK (each instruction is half a bit period).

.program audio_i2s
.side_set 2

;                          side-set = 0bBL  (B = BCLK, L = LRCLK)
.wrap_target
    set x, 14       side 0b10  ; preload 15-1 counter; BCLK high, LR low
left_data:
    out pins, 1     side 0b00  ; shift out data bit; BCLK low (data changes)
    jmp x-- left_data side 0b10 ; BCLK high (DAC samples); loop 15 times
    out pins, 1     side 0b01  ; 16th bit out; BCLK low, LR goes high (right channel)
    set x, 14       side 0b11  ; preload counter; BCLK high, LR high
right_data:
    out pins, 1     side 0b01  ; shift out data bit; BCLK low
    jmp x-- right_data side 0b11 ; BCLK high; loop 15 times
    out pins, 1     side 0b00  ; 16th bit out; BCLK low, LR goes low (left channel)
.wrap


% c-sdk {
// lrclk_pin: LRCLK, BCLK must be lrclk_pin + 1.
// The caller must have set the PIO's GPIO base (pio_set_gpio_base) for pins >= 32.
static inline void audio_i2s_program_init(PIO pio, uint sm, uint offset,
                                           uint din_pin, uint lrclk_pin) {
    pio_gpio_init(pio, din_pin);
    pio_gpio_init(pio, lrclk_pin);      // LRCLK
    pio_gpio_init(pio, lrclk_pin + 1);  // BCLK
    pio_sm_set_consecutive_pindirs(pio, sm, din_pin, 1, true);
    pio_sm_set_consecutive_pindirs(pio, sm, lrclk_pin, 2, true);

    pio_sm_config c = audio_i2s_program_get_default_config(offset);
    sm_config_set_out_pins(&c, din_pin, 1);
    sm_config_set_sideset_pins(&c, lrclk_pin);

    // Autopull at 32 bits, shift left (MSB first)
    sm_config_set_out_shift(&c, false, true, 32);

    // Join FIFOs for TX (8-deep)
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX);

    pio_sm_init(pio, sm, offset, &c);
}
%}
